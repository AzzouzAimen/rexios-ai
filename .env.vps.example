# Copy to .env.vps on the VPS. Generate separate random hex values for both.
# Blank secrets deliberately prevent Compose from starting.
POSTGRES_PASSWORD=
SESSION_SECRET=

# Optional Google sign-in. Create a Web application OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://rexios.duckdns.org/api/auth/google/callback

# Intentionally short credentials for the course demonstration.
DEMO_PASSWORD=123

# Existing network used by the shared Caddy proxy. Never remove this network.
REXIOS_EDGE_NETWORK=fidelgo-vps-dev-edge

# Optional AI briefing. Leave the key blank to keep manual posting available.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=google/gemma-4-31B-it
AI_REQUEST_TIMEOUT_MS=180000
AI_MAX_OUTPUT_TOKENS=12000
AI_MAX_REPAIR_ATTEMPTS=2
