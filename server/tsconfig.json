{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2023", "outDir": "dist", "rootDir": "src",
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "esModuleInterop": true, "resolveJsonModule": true, "strict": true, "skipLibCheck": true,
    "sourceMap": true, "noUnusedLocals": true
  },
  "include": ["src/**/*.ts"]
}
