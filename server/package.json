{
  "name": "rexios-api",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:proposals": "tsx scripts/seed-proposal-demo.ts",
    "test:ai": "tsx --test --test-concurrency=1 test/ai-brief*.test.ts",
    "ai:evaluate": "tsx scripts/evaluate-ai-brief.ts",
    "ai:index-guide": "tsx scripts/index-platform-guide.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "@langchain/openai": "1.7.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "^12.0.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express-session": "^1.18.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yauzl": "^3.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.6",
    "@types/yauzl": "^2.10.3",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
