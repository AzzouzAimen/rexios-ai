# Compose database settings. Use a URL-safe password (hex is a good choice).
POSTGRES_USER=rexios
POSTGRES_PASSWORD=rexios_local
POSTGRES_DB=rexios

# Replace this before hosting. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-random-secret

# Local packaged demo origin. Set to your HTTPS origin when hosted.
APP_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
WEB_BIND=127.0.0.1
WEB_PORT=8080
DEMO_PASSWORD=123

# Featherless AI (server-side only). Create a key at https://featherless.ai/account/api-keys.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=google/gemma-4-31B-it
FEATHERLESS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
AI_REQUEST_TIMEOUT_MS=180000
AI_MAX_OUTPUT_TOKENS=12000
AI_MAX_REPAIR_ATTEMPTS=2

# Set both to true when HTTPS terminates at a trusted reverse proxy.
SECURE_COOKIES=false
TRUST_PROXY=false
